# [LOCAL_TIER_IGNORE]
# Exclude the local-only sensitive tier from the baseline repository
/continuum-local/
/rituals/gateway_state.json
/rituals/intent_ledger.json
*.pyc
__pycache__/
.DS_Store
.env
.env.local
*.local
logs/
scratchpad/
inbox/
/reports/
# Ephemeral demo outputs (keys + cose bytes regenerated each run)
/examples/scitt_four_layer/out/
/examples/scitt_four_layer/__pycache__/

# Cleanroom private keys never leave the machine (public.key is tracked)
rust/ep-cleanroom-verifier/keys/private-key.pem
rust/ep-cleanroom-verifier/keys/*.pem
!rust/ep-cleanroom-verifier/keys/public.key

